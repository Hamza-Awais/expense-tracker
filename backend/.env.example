# Is file ko copy karke .env naam se save karein, phir apni asli values daalein.
# .env kabhi GitHub par push NAHI karni (wo .gitignore mein hai).

PORT=5000

# Apna Atlas connection string yahan paste karein.
# <password> ki jagah apna database user ka password likhein.
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/expense-tracker
